generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Chat {
  id        String    @id @default(cuid())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  selectedPromptId String?
}

model Message {
  id        String   @id @default(cuid())
  role      String   // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Settings {
  id                   String  @id @default("default")
  ollamaUrl            String  @default("http://127.0.0.1:11434")
  lmstudioUrl          String  @default("http://127.0.0.1:1234")
  openaiKey            String  @default("")
  anthropicKey         String  @default("")
  googleKey            String  @default("")
  deepseekKey          String  @default("")
  minimaxKey           String  @default("")
  groqKey              String  @default("")
  mistralKey           String  @default("")
  zhipuKey             String  @default("")
  lingyiKey            String  @default("")
  openrouterKey        String  @default("")
  nvidiaKey            String  @default("")
  defaultModel         String  @default("llama3")
  searchEngine         String  @default("duckduckgo")
  searchKey            String  @default("")
  embeddingModel       String  @default("text-embedding-3-small")
  hybridSearchEnabled  Boolean @default(true)
  localGgufEnabled     Boolean @default(false)
  localGgufContextSize Int     @default(4096)
  localGgufTemperature Float   @default(0.7)
  localGgufTopP        Float   @default(0.95)
  localGgufRepeatPenalty Float @default(1.1)
  localGgufMaxTokens   Int     @default(1024)
  apiTemperature       Float   @default(0.7)
  apiTopP              Float   @default(0.9)
  apiMaxTokens         Int     @default(2048)
  apiContextSize       Int     @default(8192)
  theme                String  @default("zinc")
  mcpEnabled           Boolean @default(true)
  mcpAutoLoad          Boolean @default(false)
  enabledModels        String  @default("[]")
  maxConcurrentChats   Int     @default(3)
}

model KnowledgeBase {
  id            String   @id @default(cuid())
  name          String
  sourceType    String   // local, api
  engine        String   // directory, json-api
  path          String?
  config        String   @default("{}") // JSON string
  stats         String   @default("{}") // JSON string
  status        String   @default("idle") // idle, indexing, ready, error
  lastError     String   @default("")
  lastIndexedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chunks        KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sourceUri       String
  title           String
  chunkIndex      Int
  content         String
  keywords        String
  metadata        String        @default("{}") // JSON
  embedding       String?       // JSON array of floats for sqlite
}

model McpServer {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("stdio") // stdio, sse
  command   String?
  args      String?  // JSON array of strings
  url       String?
  env       String?  // JSON object string
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataSource {
  id            String    @id @default(cuid())
  name          String
  type          String    // database, api, file, backup
  engine        String    // postgres, mysql, sqlserver, sqlite, rest, csv, xlsx, json
  path          String?   // file path for sqlite/file sources
  config        String    @default("{}") // JSON config (host, port, credentials - sensitive keys sanitized)
  metadata      String    @default("{}") // JSON metadata (schema snapshots, table lists)
  status        String    @default("idle") // idle, syncing, ready, error
  lastError     String    @default("")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  content     String
  description String?
  icon        String?  @default("Sparkles")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
